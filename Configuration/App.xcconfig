
PRODUCT_BUNDLE_IDENTIFIER = co.sstools.Batty

// #0279 review round 1: pulled out of a plain PRODUCT_NAME so BattyTests'
// TEST_HOST / BUNDLE_LOADER (project.pbxproj) can reference the same
// variant-derived app product name — those used to hardcode the literal
// "Batty.app", which broke `build-for-testing` once Beta got a distinct
// PRODUCT_NAME. BattyTests now carries baseConfigurationReference =
// App.xcconfig (same file the "Batty" app target itself uses) so this
// variable — and Beta.xcconfig's override of it — are visible there too.
//
// #0279 review round 2: that inheritance has a real side effect —
// GENERATE_INFOPLIST_FILE = YES does NOT override an inherited
// INFOPLIST_FILE, it MERGES with it: this file's INFOPLIST_FILE
// (Configuration/Info.plist, the real app's plist — CFBundleURLTypes,
// NSPrincipalClass, every usage-description string) was ending up baked
// into BattyTests.xctest's generated Info.plist, verified by inspecting
// the built plist directly. That's a nested bundle registering as a third
// batty:// scheme handler — exactly the ambiguity leak 3 of this issue is
// about, just one layer down. BattyTests' own target-level
// INFOPLIST_FILE = "" (project.pbxproj) empties the inherited value so
// GENERATE_INFOPLIST_FILE produces a clean plist instead of merging.
APP_PRODUCT_NAME = Batty

// Signing mode (#0503). Routine builds (./build.sh, Xcode, unit tests, the
// UI-test VM) sign Automatically with no profile and the entitlements file
// that holds no restricted key. A Developer ID build passes
// BATTY_SIGNING=developerid on the command line (build.sh package --sign and
// scripts/release.sh only) and gets Manual signing, the Developer
// ID identity, the iCloud entitlement and the committed profile for its variant.
// The command-line flag is read here, so it reaches this project's targets
// only; Swift package targets, which cannot take a profile, never see it.
// BattyTests shares this file, so its target settings pin the routine values.
BATTY_SIGNING = routine
BATTY_CODE_SIGN_STYLE_routine = Automatic
BATTY_CODE_SIGN_STYLE_developerid = Manual
BATTY_CODE_SIGN_IDENTITY_routine = Apple Development
BATTY_CODE_SIGN_IDENTITY_developerid = Developer ID Application
BATTY_ENTITLEMENTS_routine = Batty/Batty-local.entitlements
BATTY_ENTITLEMENTS_developerid = Batty/Batty.entitlements
BATTY_PROFILE_routine =
BATTY_PROFILE_developerid = $(BATTY_DEVELOPER_ID_PROFILE)
BATTY_DEVELOPER_ID_PROFILE = Batty Developer ID
CODE_SIGN_STYLE = $(BATTY_CODE_SIGN_STYLE_$(BATTY_SIGNING))
CODE_SIGN_IDENTITY = $(BATTY_CODE_SIGN_IDENTITY_$(BATTY_SIGNING))
BATTY_ENTITLEMENTS = $(BATTY_ENTITLEMENTS_$(BATTY_SIGNING))
PROVISIONING_PROFILE_SPECIFIER = $(BATTY_PROFILE_$(BATTY_SIGNING))
PRODUCT_NAME = $(APP_PRODUCT_NAME)
MARKETING_VERSION = 1.2.0
CURRENT_PROJECT_VERSION = 1

INFOPLIST_FILE = Configuration/Info.plist

ASSETCATALOG_COMPILER_APPICON_NAME[sdk=macos*] = AppIcon

// Avoid using double slash which becomes a comment
HTTPS=https:/

// Sparkle
SU_FEED_URL = $HTTPS/batty.sstools.co/appcast.xml
SU_PUBLIC_ED_KEY = 17V/QFAmgnEvb+YhA0+c/oA8TghcNVLOY5qYIa6aMZA=

// Environment override — written by scripts/set-environment.sh before each build.
// The ? makes it optional so builds work on a fresh clone without Active.xcconfig.
// Values in Active.xcconfig override the defaults above.
#include? "Active.xcconfig"
